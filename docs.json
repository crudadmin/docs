      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/crudadmin"
    }
  },
  "redirects": [
    {
      "source": "/helpers/installation",
      "destination": "/packages/helpers"
    },
    {
      "source": "/helpers/authentication",
      "destination": "/packages/helpers/authentication"
    },
    {
      "source": "/helpers/authentication/:slug*",
      "destination": "/packages/helpers/authentication/:slug*"
    }
  ]
